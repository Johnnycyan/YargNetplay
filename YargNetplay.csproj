<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>YargNetplay</AssemblyName>
    <!-- Plugin.Version comes from this (BuildInfo.g.cs). CI release builds override it from the tag: -p:Version=1.2.3 -->
    <Version>0.2.0</Version>
    <RootNamespace>YargNetplay</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Compile against the game's own Mono BCL (its mscorlib has Span<T>, which YARG.Core uses). -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>

    <!-- YARG install to compile against (and deploy into, if BepInEx is installed there).
         Override with: dotnet build -p:YargDir="C:\path\to\YARG" -->
    <YargDir Condition="'$(YargDir)' == ''">$(LOCALAPPDATA)\YARC\YARG Installs\cd3bd653-c9f2-420e-a575-5a1ef115cdda\installation</YargDir>
    <YargManaged>$(YargDir)\YARG_Data\Managed</YargManaged>

    <!-- Newer nightlies (b4161 on) play setlists through the static YARG.Playlists.Setlist instead of PersistentState's
         ShowSongs/ShowIndex (see src/Game/Show.cs). Detected from the game assembly; override with -p:YargStaticSetlist=true|false -->
    <YargStaticSetlist Condition="'$(YargStaticSetlist)' == '' And Exists('$(YargManaged)\Assembly-CSharp.dll')">$([System.IO.File]::ReadAllText('$(YargManaged)\Assembly-CSharp.dll').Contains('ResolveSongs'))</YargStaticSetlist>
    <DefineConstants Condition="'$(YargStaticSetlist)' == 'true'">$(DefineConstants);YARG_STATIC_SETLIST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(YargManaged)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(YargManaged)\netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(YargManaged)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(YargManaged)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(YargManaged)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(YargManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="YARG.Core.Package"><HintPath>$(YargManaged)\YARG.Core.Package.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(YargManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(YargManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(YargManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(YargManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UniTask"><HintPath>$(YargManaged)\UniTask.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(YargManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(YargManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(YargManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(YargManaged)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(YargManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToYarg" AfterTargets="Build" Condition="Exists('$(YargDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(YargDir)\BepInEx\plugins\YargNetplay" />
  </Target>

  <!-- Plugin.Version as a compile-time constant (BepInPlugin needs a const), from $(Version). -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace YargNetplay { internal static class BuildInfo { public const string Version = &quot;$(Version)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Release builds also produce the release assets in dist\: YargNetplay.dll (what the installers download)
       and YargNetplay-Installer.zip (the installers, which fetch the newest YargNetplay.dll from GitHub). -->
  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageDir>$(BaseIntermediateOutputPath)package\</PackageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageDir);dist" />
    <MakeDir Directories="dist" />
    <Copy SourceFiles="installer\install.ps1;installer\Install YARG Netplay.bat;installer\install.sh" DestinationFolder="$(PackageDir)" />
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="dist\YargNetplay-Installer.zip" Overwrite="true" />
    <Copy SourceFiles="$(TargetPath);installer\install.ps1;installer\install.sh" DestinationFolder="dist" />
  </Target>

</Project>
